void showStartupScreens() {
lcd.clear();

lcd.setCursor(0, 0);
lcd.print("SMART VEHICLE");

lcd.setCursor(0, 1);
lcd.print("IMMOBILIZER");

delay(2000);

lcd.clear();

lcd.setCursor(0, 0);
lcd.print("KEYLESS IGNITION");

lcd.setCursor(0, 1);
lcd.print("SYSTEM");

delay(2000);
}

void setup() {
Serial.begin(9600);

pinMode(IN1, OUTPUT);
pinMode(IN2, OUTPUT);
pinMode(ENA, OUTPUT);

pinMode(GREEN_LED, OUTPUT);
pinMode(RED_LED, OUTPUT);
pinMode(BUZZER, OUTPUT);

stopVehicle();

SPI.begin();
rfid.PCD_Init();

lcd.init();
lcd.backlight();

showStartupScreens();
showReadyScreen();

Serial.println("SMART VEHICLE READY");
}

void loop() {
updateLEDs();

if (!rfid.PICC_IsNewCardPresent()) {
return;
}

if (!rfid.PICC_ReadCardSerial()) {
return;
}

if (isAuthorizedCard()) {

